<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WifiCam.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WifiCam Studio">

    <Grid Background="{StaticResource StudioBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Extended Windows 11 Studio Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/wificam-logo.png" Width="22" Height="22" />
                <Ellipse x:Name="LiveStatusDot" Width="8" Height="8" Fill="{StaticResource StudioInkSecondaryBrush}" />
                <TextBlock Text="WifiCam Studio" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource StudioInkPrimaryBrush}" />
                <Border Background="{StaticResource StudioCardBrush}" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,3">
                    <TextBlock x:Name="TierBadgeText" Text="STANDBY" FontFamily="Cascadia Mono" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StudioAccentBrush}" />
                </Border>
                <Border Background="{StaticResource StudioCardBrush}" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,3">
                    <TextBlock Text="ZERO CLOUD • E2E LAN" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Two-Column Studio Console -->
        <ScrollViewer Grid.Row="1" Padding="20,8,20,20">
            <Grid ColumnSpacing="18" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Live Camera Slate, Quick Controls & 16-Segment VU Meter -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <!-- Camera Status & Preview Surface Card -->
                    <Border Background="{StaticResource StudioElevatedBrush}" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="Virtual Camera" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource StudioInkPrimaryBrush}" />
                                    <Border Background="{StaticResource StudioCardBrush}" CornerRadius="8" Padding="8,3">
                                        <TextBlock x:Name="VideoModeText" Text="1920x1080 • NV12" FontFamily="Cascadia Mono" FontSize="12" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <Button x:Name="StartStopButton"
                                        HorizontalAlignment="Right"
                                        Content="Start Studio Engine"
                                        Background="{StaticResource StudioAccentBrush}"
                                        Foreground="{StaticResource StudioInkOnAccentBrush}"
                                        FontWeight="SemiBold"
                                        CornerRadius="12"
                                        Padding="16,9"
                                        Click="OnStartStopClick" />
                            </Grid>

                            <!-- 16:9 Live Camera Preview Viewport -->
                            <Border Height="270" Background="#000000" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <!-- Live hardware-decoded BGRA32 camera preview -->
                                    <Image x:Name="LivePreviewImage" Stretch="Uniform" Visibility="Collapsed" />

                                    <!-- Status Slate Overlay (shown when waiting, paused, or locked) -->
                                    <StackPanel x:Name="ViewportSlateOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock x:Name="ViewportHeadline" Text="Waiting for Android Phone" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource StudioInkPrimaryBrush}" />
                                        <TextBlock x:Name="ViewportSubtitle" Text="Plug in via USB (AOA / ADB) or scan the QR code on the right for encrypted Wi-Fi" FontSize="12" Foreground="{StaticResource StudioInkSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />
                                    </StackPanel>

                                    <!-- Subtle bottom-left live frame/audio telemetry pill -->
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Background="#CC0D0F12" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock x:Name="FramesCounterText" Text="VIDEO 0 f" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource StudioAccentBrush}" />
                                            <TextBlock x:Name="AudioCounterText" Text="AUDIO 0 pkt" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource StudioLiveBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Preview & Virtual Camera Transform Toolbar (Rotate, Flip H, Flip V, Crop/Zoom) -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="RotateButton" Grid.Column="0" HorizontalAlignment="Stretch" Content="Rotate 0°" CornerRadius="10" Padding="8,7" FontSize="12" Click="OnRotateClick" />
                                <ToggleButton x:Name="FlipHToggle" Grid.Column="1" HorizontalAlignment="Stretch" Content="Mirror H" CornerRadius="10" Padding="8,7" FontSize="12" Click="OnTransformToggleClick" />
                                <ToggleButton x:Name="FlipVToggle" Grid.Column="2" HorizontalAlignment="Stretch" Content="Flip V" CornerRadius="10" Padding="8,7" FontSize="12" Click="OnTransformToggleClick" />
                                <Button x:Name="CropZoomButton" Grid.Column="3" HorizontalAlignment="Stretch" Content="Crop 1.0x" CornerRadius="10" Padding="8,7" FontSize="12" Click="OnCropZoomClick" />
                            </Grid>

                            <!-- Quick Action Controls -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="PauseVideoToggle" Grid.Column="0" HorizontalAlignment="Stretch" Content="Pause Video" CornerRadius="12" Padding="10" Click="OnPauseVideoClick" />
                                <ToggleButton x:Name="MuteMicToggle" Grid.Column="1" HorizontalAlignment="Stretch" Content="Mute Mic" CornerRadius="12" Padding="10" Click="OnMuteMicClick" />
                                <Button x:Name="UsbAdbButton" Grid.Column="2" HorizontalAlignment="Stretch" Content="USB ADB Link" CornerRadius="12" Padding="10" Click="OnUsbAdbClick" />
                            </Grid>

                            <TextBlock x:Name="UsbStatusText" Text="Virtual Camera Driver: Checking Windows 11 Media Foundation..." FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Broadcast 16-Segment LED VU Meter & Telemetry Card -->
                    <Border Background="{StaticResource StudioElevatedBrush}" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="Studio Microphone Monitor" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource StudioInkPrimaryBrush}" />
                                <TextBlock x:Name="VuDbText" HorizontalAlignment="Right" Text="-∞ dBFS" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                            </Grid>

                            <!-- 16-Segment Broadcast LED Bar (10 Green, 4 Amber, 2 Peak Red) -->
                            <Grid x:Name="VuMeterGrid" Height="16" ColumnSpacing="4" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource StudioCardBrush}" CornerRadius="8" Padding="10,7">
                                    <StackPanel>
                                        <TextBlock Text="VOICE ACTIVITY" FontSize="10" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                                        <TextBlock x:Name="VadText" Text="0 %" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource StudioLiveBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource StudioCardBrush}" CornerRadius="8" Padding="10,7">
                                    <StackPanel>
                                        <TextBlock Text="CLOCK DRIFT SERVO" FontSize="10" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                                        <TextBlock x:Name="SkewText" Text="+0.0 ppm" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource StudioAccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource StudioCardBrush}" CornerRadius="8" Padding="10,7">
                                    <StackPanel>
                                        <TextBlock Text="SAMPLE RATE" FontSize="10" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                                        <TextBlock Text="48 kHz PCM/Opus" FontFamily="Cascadia Mono" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StudioInkPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="VirtualMicStatusText" Grid.Column="0" VerticalAlignment="Center" Text="Virtual Mic Sink: Detecting..." FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource StudioInkSecondaryBrush}" TextWrapping="Wrap" />
                                <Button x:Name="SetupVirtualMicButton" Grid.Column="1" Content="Setup Virtual Mic" Background="{StaticResource StudioAccentBrush}" Foreground="{StaticResource StudioInkOnAccentBrush}" FontWeight="SemiBold" FontSize="11" CornerRadius="8" Padding="10,6" Click="OnSetupVirtualMicClick" />
                                <Button x:Name="RefreshVirtualMicButton" Grid.Column="2" Content="Refresh" FontSize="11" CornerRadius="8" Padding="10,6" Click="OnRefreshVirtualMicClick" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: Fast Wireless QR Pairing, AI Audio DSP & Privacy -->
                <StackPanel Grid.Column="1" Spacing="16">

                    <!-- Connect Phone to This PC (QR Code) -->
                    <Border Background="{StaticResource StudioElevatedBrush}" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Connect Phone to This PC" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource StudioInkPrimaryBrush}" />
                            <TextBlock Text="Open WifiCam on Android and scan this PC pairing code to stream directly to this computer." FontSize="12" Foreground="{StaticResource StudioInkSecondaryBrush}" TextWrapping="Wrap" />

                            <Border HorizontalAlignment="Center" Background="#FFFFFF" CornerRadius="14" Padding="10">
                                <Image x:Name="PairingQrImage" Width="184" Height="184" Stretch="Uniform" />
                            </Border>

                            <Border Background="{StaticResource StudioCardBrush}" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="PcNameText" Text="PC: THIS COMPUTER" FontFamily="Cascadia Mono" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StudioInkPrimaryBrush}" />
                                    <TextBlock x:Name="LanAddressText" Text="Address: 127.0.0.1 • TCP 7890 / UDP 7891" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource StudioAccentBrush}" />
                                    <TextBlock x:Name="FingerprintText" Text="Security ID: ----" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Studio Audio DSP Controls -->
                    <Border Background="{StaticResource StudioElevatedBrush}" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Studio Audio DSP" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource StudioInkPrimaryBrush}" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="AI Noise Suppression" FontSize="12" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                                <ComboBox x:Name="DenoiseCombo" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="OnDenoiseSelectionChanged">
                                    <ComboBoxItem Content="Off (Raw Studio Mic)" />
                                    <ComboBoxItem Content="RNNoise AI (~10 ms Ultra-Low Latency)" />
                                    <ComboBoxItem Content="DeepFilterNet3 (Studio Clarity Mode)" />
                                </ComboBox>
                            </StackPanel>

                            <ToggleSwitch x:Name="AecToggle"
                                          Header="WebRTC AEC3 Echo Cancellation"
                                          IsOn="False"
                                          OnContent="Active (Cancels PC Speaker Echo)"
                                          OffContent="Off (Recommended — Raw/RNNoise Mic)"
                                          Toggled="OnAecToggled" />

                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="Microphone Gain" FontSize="12" Foreground="{StaticResource StudioInkSecondaryBrush}" />
                                    <TextBlock x:Name="GainValueText" HorizontalAlignment="Right" Text="0.0 dB" FontFamily="Cascadia Mono" FontSize="12" Foreground="{StaticResource StudioInkPrimaryBrush}" />
                                </Grid>
                                <Slider x:Name="GainSlider" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0" ValueChanged="OnGainChanged" />
                            </StackPanel>

                            <ToggleSwitch x:Name="LockPrivacyToggle"
                                          Header="Privacy Lock Guard (Win+L)"
                                          IsOn="True"
                                          OnContent="Auto-pause camera &amp; mute mic on Windows lock"
                                          OffContent="Disabled" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
