<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WifiCam.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Exact WCAG-validated WifiCam Studio tokens from DESIGN.md -->
            <SolidColorBrush x:Key="StudioBaseBrush" Color="#0D0F12" />
            <SolidColorBrush x:Key="StudioElevatedBrush" Color="#161A20" />
            <SolidColorBrush x:Key="StudioCardBrush" Color="#1D222B" />
            <SolidColorBrush x:Key="StudioBorderBrush" Color="#2B3240" />
            <SolidColorBrush x:Key="StudioInkPrimaryBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="StudioInkSecondaryBrush" Color="#9CA8BA" />
            <SolidColorBrush x:Key="StudioInkOnAccentBrush" Color="#061018" />
            <SolidColorBrush x:Key="StudioAccentBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="StudioLiveBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="StudioWarnBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="StudioAlertBrush" Color="#F43F5E" />
            <SolidColorBrush x:Key="StudioVuNominalBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="StudioVuHotBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="StudioVuClipBrush" Color="#EF4444" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
